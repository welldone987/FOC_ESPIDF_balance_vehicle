# esp_simplefoc requires a 1 kHz FreeRTOS tick for its delay/timing compatibility layer.
CONFIG_FREERTOS_HZ=1000

# Native BLE backend: use ESP-IDF NimBLE, never Arduino BLE or Bluedroid.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4000

# Persist fatal crash task/register/stack state to the custom coredump partition.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
CONFIG_ESP_COREDUMP_STACK_SIZE=1792
